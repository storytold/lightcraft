  {
    "name": "mask-2-linear",
    "steps": [
      {
        "method": "ui.clickWidget",
        "params": {
          "id": "maskNew:linear"
        }
      },
      {
        "method": "ui.pointer",
        "params": {
          "events": [
            {
              "kind": "down",
              "x": 0.5,
              "y": 0.02
            },
            {
              "kind": "drag",
              "x": 0.5,
              "y": 0.25
            },
            {
              "kind": "drag",
              "x": 0.5,
              "y": 0.45
            },
            {
              "kind": "up",
              "x": 0.5,
              "y": 0.45
            }
          ]
        }
      }
    ]
  },
  {
    "name": "mask-3-adjust",
    "steps": [
      {
        "method": "engine.execute",
        "params": {
          "command": "mask.adjust",
          "params": {
            "values": {
              "exposure": -0.6,
              "temp": 25,
              "saturation": 20,
              "dehaze": 20
            }
          }
        }
      }
    ]
  },
  {
