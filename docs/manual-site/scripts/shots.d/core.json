      {
        "method": "ui.set",
        "params": {
          "leftPanel": true,
          "thumbSize": 150
        }
      }
    ]
  },
  {
    "name": "develop",
    "steps": [
      {
        "method": "ui.dialog.cancel",
        "params": {}
      },
      {
        "method": "engine.execute",
        "params": {
          "command": "plugins.manager",
          "params": {
            "open": false
          }
        }
      },
      {
        "method": "engine.execute",
        "params": {
          "command": "plugins.marketplace",
          "params": {
            "open": false
          }
        }
      },
      {
        "method": "engine.execute",
        "params": {
          "command": "library.select",
          "params": {
            "ids": [
              1
            ]
          }
        }
      },
      {
        "method": "engine.execute",
        "params": {
          "command": "module.develop"
        }
      },
      {
        "method": "engine.execute",
        "params": {
          "command": "tool.done"
        }
      },
      {
        "method": "engine.execute",
        "params": {
          "command": "tool.none"
        }
      },
      {
        "method": "ui.clickWidget",
        "params": {
          "id": "modern:group:light"
        },
        "only": [
          "modern"
        ]
      },
      {
        "method": "engine.execute",
        "params": {
          "command": "develop.set",
          "params": {
            "values": {
              "light.highlights": -55,
              "light.shadows": 35,
              "color.vibrance": 25,
              "effects.clarity": 15
            }
          }
        }
      }
    ]
  },
  {
    "name": "mask-1-open",
