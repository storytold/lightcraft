<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: packaging/macos/package.sh (and `cargo xtask package`) fill the {{…}} placeholders from
     brand.toml, plus {{version}} (full, e.g. 0.2.0-rc.1), {{short_version}} (numeric X.Y.Z) and {{build_sha}}. -->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleDisplayName</key>
  <string>{{display_name}}</string>
  <key>CFBundleName</key>
  <string>{{short_name}}</string>
  <key>CFBundleExecutable</key>
  <string>{{display_name}}</string>
  <key>CFBundleIdentifier</key>
  <string>{{app_id}}</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleSignature</key>
  <string>????</string>
  <key>CFBundleShortVersionString</key>
  <string>{{short_version}}</string>
  <key>CFBundleVersion</key>
  <string>{{short_version}}</string>
  <key>AppFullVersion</key>
  <string>{{version}}</string>
  <key>AppBuildCommit</key>
  <string>{{build_sha}}</string>
  <key>CFBundleIconFile</key>
  <string>{{display_name}}</string>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.graphics-design</string>
  <!-- Must match MACOSX_DEPLOYMENT_TARGET in package.sh. Big Sur is the first release on
       Apple silicon and has the Metal feature set wgpu targets. -->
  <key>LSMinimumSystemVersion</key>
  <string>11.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSSupportsAutomaticGraphicsSwitching</key>
  <true/>
  <key>NSRequiresAquaSystemAppearance</key>
  <false/>
  <key>NSHumanReadableCopyright</key>
  <string>Copyright © {{vendor}}. MIT.</string>

  <!-- The app's own format. -->
  <key>UTExportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>{{app_id}}.document</string>
      <key>UTTypeDescription</key>
      <string>{{display_name}} Document</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.data</string>
        <string>public.image</string>
      </array>
      <key>UTTypeIconFile</key>
      <string>{{display_name}}</string>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array><string>pcraft</string></array>
        <key>public.mime-type</key>
        <array><string>application/x-{{binary}}</string></array>
      </dict>
    </dict>
  </array>
  <!-- Types macOS may not know; the system's own declaration wins when it has one. -->
  <key>UTImportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>com.adobe.photoshop-large-image</string>
      <key>UTTypeDescription</key>
      <string>Photoshop Large Document</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.data</string>
        <string>public.image</string>
      </array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array><string>psb</string></array>
      </dict>
    </dict>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>{{app_id}}.qoi</string>
      <key>UTTypeDescription</key>
      <string>QOI Image</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.data</string>
        <string>public.image</string>
      </array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array><string>qoi</string></array>
      </dict>
    </dict>
  </array>

</dict>
</plist>
