[Desktop Entry]
Type=Application
Name=LightCraft
Name[ru]=LightCraft
GenericName=Photo Library and Raw Developer
GenericName[ru]=Фотобиблиотека и RAW-конвертер
Comment=Organise photos and develop raw files, non-destructively
Comment[ru]=Упорядочивание фотографий и неразрушающая обработка RAW-файлов
Exec=lightcraft %F
Icon=ai.storyteller.lightcraft
Terminal=false
Categories=Graphics;2DGraphics;RasterGraphics;Photography;
Keywords=photo;raw;camera;library;develop;
Keywords[ru]=фото;фотография;raw;камера;библиотека;обработка;коррекция;
StartupWMClass=ai.storyteller.lightcraft
MimeType=image/heic;image/heif;image/jpeg;image/png;image/tiff;image/webp;image/x-adobe-dng;image/x-sony-arw;image/x-canon-cr2;image/x-canon-cr3;image/x-nikon-nef;image/x-fuji-raf;image/x-olympus-orf;image/x-panasonic-rw2;image/x-panasonic-rw;image/x-pentax-pef;
