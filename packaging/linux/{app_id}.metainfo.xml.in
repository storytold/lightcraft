<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). Template: `cargo xtask package`, package.sh and
     the Flatpak build fill the {{…}} placeholders from brand.toml, Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>{{app_id}}</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT AND Apache-2.0</project_license>
  <name>{{display_name}}</name>
  <summary>{{tagline}}</summary>
  <developer id="{{app_id}}">
    <name>{{vendor}}</name>
  </developer>
  <description>
    <p>
      {{display_name}} is a photo library and raw developer. Organise photos and develop raw files, non-destructively.
    </p>
    <p>Its modules follow the classic photo-workflow layout:</p>
    <ul>
      <li>Library: folders, albums, smart albums, ratings, flags, colour labels, keywords and people</li>
      <li>Develop: non-destructive raw development with masks, presets, HDR and panorama merge</li>
      <li>Map: geotagging, GPX track logs and saved locations</li>
      <li>Book: photo books exported as PDF or JPEG pages</li>
      <li>Slideshow: slideshows with titles, overlays and music</li>
      <li>Print: print layouts to PDF, JPEG or an IPP printer</li>
      <li>Web: HTML galleries, exported or uploaded over SFTP</li>
    </ul>
    <p>
      Publish services, Immich sync, tethered studio capture, Edit In external editors, recorded actions and
      WebAssembly plug-ins. Every action is also a command for the command line and AI agents.
    </p>
  </description>
  <launchable type="desktop-id">{{app_id}}.desktop</launchable>
  <icon type="stock">{{app_id}}</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <url type="homepage">{{homepage}}</url>
  <url type="bugtracker">{{repository}}/issues</url>
  <url type="help">{{repository}}</url>
  <categories>
    <category>Graphics</category>
    <category>RasterGraphics</category>
    <category>Photography</category>
  </categories>
  <keywords>
    <keyword>photo</keyword>
    <keyword>raw</keyword>
    <keyword>library</keyword>
    <keyword>develop</keyword>
    <keyword>geotag</keyword>
    <keyword>photo book</keyword>
    <keyword>slideshow</keyword>
    <keyword>print</keyword>
    <keyword>web gallery</keyword>
    <keyword>tethering</keyword>
  </keywords>
  <branding>
    <color type="primary" scheme_preference="light">#9fd0ff</color>
    <color type="primary" scheme_preference="dark">#1f64ba</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>tablet</control>
  </supports>
  <provides>
    <binary>{{binary}}</binary>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="{{version}}" date="{{date}}"/>
  </releases>
</component>
