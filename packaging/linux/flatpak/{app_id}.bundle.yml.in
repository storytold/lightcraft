# Flatpak manifest for the single-file bundle attached to every GitHub release
# (<binary>-<version>-linux-<arch>.flatpak). Build it with packaging/linux/flatpak-bundle.sh.
# A template: the {{…}} placeholders come from brand.toml.
#
# It repackages the release's own Linux tarball (<binary>-<version>-linux-<arch>.tar.gz,
# built on Ubuntu 22.04 by package.sh) instead of compiling Rust inside flatpak-builder: no
# network and no vendored crate sources during the build, a few seconds instead of 20+ minutes,
# and byte-for-byte the same binaries as the AppImage/deb/rpm. The script unpacks the tarball
# into `stage/` next to a copy of this file. The binaries need glibc >= 2.35 and load X11,
# Wayland, xkbcommon and Vulkan at runtime; the freedesktop runtime has all of them, and the
# GPU driver comes from its org.freedesktop.Platform.GL extension.
#
# {app_id}.yml.in (same directory) is the from-source manifest for Flathub. Keep
# runtime-version and finish-args identical in both (packaging-lint checks this).
id: {{app_id}}
runtime: org.freedesktop.Platform
runtime-version: '25.08'
sdk: org.freedesktop.Sdk
command: {{binary}}
finish-args:
  # Display: Wayland first; X11 only when no Wayland compositor is running.
  - --socket=wayland
  - --socket=fallback-x11
  # X11 shared memory (MIT-SHM). Without it the X11 fallback is slow or fails.
  - --share=ipc
  # GPU access for the wgpu renderer (Vulkan, or GL as a fallback).
  - --device=dri
  # The library lives in ~/Pictures/{{library_default}} by default, and imports usually come from
  # Pictures. Open/Save dialogs go through the file-chooser portal (rfd's xdg-portal backend) and
  # drag-and-drop through the document portal, so picked folders elsewhere work without broad
  # filesystem access.
  - --filesystem=xdg-pictures
  # Network: map tiles, reverse geocoding, Immich, publish services, SFTP web upload, IPP printing,
  # PTP/IP tethering and model downloads. Each is opt-in inside the app; nothing connects unasked.
  - --share=network
  # USB cameras for native tethering (PTP). `--device=usb` (Flatpak >= 1.15.11) is narrower but the
  # CI builder (Ubuntu 24.04, Flatpak 1.14) rejects it, so this grants all devices; see
  # docs/packaging.md. Deliberately not granted: home/host filesystem access.
  - --device=all
modules:
  - name: {{binary}}
    buildsystem: simple
    build-commands:
      - install -Dm755 bin/{{binary}} /app/bin/{{binary}}
      - install -Dm755 bin/{{cli_binary}} /app/bin/{{cli_binary}}
      - install -Dm644 share/applications/{{app_id}}.desktop /app/share/applications/{{app_id}}.desktop
      # The same MIME definitions the deb/rpm install.
      - install -Dm644 share/mime/packages/{{app_id}}.xml /app/share/mime/packages/{{app_id}}.xml
      # Already has the release's version and date substituted by package.sh.
      - install -Dm644 share/metainfo/{{app_id}}.metainfo.xml /app/share/metainfo/{{app_id}}.metainfo.xml
      - mkdir -p /app/share/icons /app/share/doc && cp -R share/icons/hicolor /app/share/icons/ && cp -R share/doc/{{binary}} /app/share/doc/
    sources:
      - type: dir
        path: stage
