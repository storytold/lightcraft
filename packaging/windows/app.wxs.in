<?xml version="1.0" encoding="utf-8"?>
<!--
  MSI template (WiX Toolset v5: `dotnet tool install -g wix`, plus the UI and Util extensions:
  `wix extension add -g WixToolset.UI.wixext/5.0.2 WixToolset.Util.wixext/5.0.2`). package.ps1 fills the {{…}}
  placeholders from brand.toml, then runs:

    wix build app.wxs -arch x64 -ext WixToolset.UI.wixext/5.0.2 -ext WixToolset.Util.wixext/5.0.2
      -d Version=1.2.3 -d BinDir=... -d IconPath=... -d UiDialogBmp=... -d UiBannerBmp=... -o out.msi

  Per-machine install into Program Files (or the folder chosen in the installer, or
  `INSTALLFOLDER=...` on the msiexec command line; upgrades keep it) and a Start Menu shortcut. The
  UpgradeCode identifies the product to Windows Installer across versions: keep it when renaming, so
  upgrades still replace the installed version.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="{{display_name}}"
      Manufacturer="{{vendor}}"
      Version="$(var.Version)"
      UpgradeCode="6F1C2E0A-3B7D-4D52-9E61-8A4C0B9D27F3"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="{{display_name}}: {{tagline}}" Manufacturer="{{vendor}}" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of {{display_name}} is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AppIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="{{homepage}}" />
    <Property Id="ARPURLUPDATEINFO" Value="{{homepage}}" />
    <Property Id="ARPHELPLINK" Value="{{repository}}" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="{{display_name}}" />
    </StandardDirectory>
    <!-- The folder of the installed version (written by DacApp), so an upgrade installs where the
         user chose instead of moving back to Program Files. Searched into its own property:
         AppSearch would otherwise overwrite INSTALLFOLDER=... given to msiexec. -->
    <Property Id="PREVIOUSINSTALLFOLDER">
      <RegistrySearch Id="PreviousInstallFolder" Root="HKLM" Key="Software\{{display_name}}" Name="InstallFolder" Type="raw" />
    </Property>
    <SetProperty Id="INSTALLFOLDER" Value="[PREVIOUSINSTALLFOLDER]" After="AppSearch" Sequence="both"
        Condition="PREVIOUSINSTALLFOLDER AND NOT INSTALLFOLDER" />
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="{{display_name}}" Level="1">
      <ComponentGroupRef Id="AppFiles" />
    </Feature>

    <UIRef Id="AppUI" />
  </Package>

  <!--
    Interactive install UI: Welcome -> Destination Folder -> Ready to install -> progress ->
    "Completed" (Finish), with a "Launch" checkbox (checked by default). Destination Folder shows
    Program Files\<app>, or the installed version's folder on an upgrade; Change... browses, and a
    folder that can't be used (InvalidDirDlg) is refused before anything is installed. Failure and
    cancellation end on WiX's standard FatalError / UserExit dialogs. Maintenance (running the MSI
    again, Repair/Remove from Apps) uses the standard maintenance dialogs.

    This is WixUI_InstallDir without its licence-acceptance page: the app is MIT, which asks nothing
    of people who just install and run it. Silent (/qn) and basic-UI (/passive, /qb) installs never
    show these dialogs, and nothing is launched.

    The dialogs, strings and error/cancel pages come from WixToolset.UI.wixext; the side and banner
    bitmaps are plain panels generated by package.ps1 (no third-party artwork).
  -->
  <Fragment>
    <WixVariable Id="WixUIDialogBmp" Value="$(var.UiDialogBmp)" />
    <WixVariable Id="WixUIBannerBmp" Value="$(var.UiBannerBmp)" />

    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT"
        Value="{{display_name}} has been installed. You can start it at any time from the Start menu." />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch {{display_name}}" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />

    <!-- "Launch" on Finish. WixUnelevatedShellExec (Util extension) asks the desktop shell
         (Explorer) to start the program, so it runs as the signed-in user at normal integrity even
         when the installer UI itself is elevated; it never runs from the elevated/SYSTEM server
         side. It is a UI-only control event, so silent and passive installs never run it.
         Return="ignore": a failed launch must not turn a successful install into an error. -->
    <Property Id="WixUnelevatedShellExecTarget" Value="[#AppExe]" />
    <CustomAction Id="LaunchApp" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
        DllEntry="WixUnelevatedShellExec" Execute="immediate" Impersonate="yes" Return="ignore" />

    <UI Id="AppUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />

      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />
      <DialogRef Id="WelcomeDlg" />
      <DialogRef Id="InstallDirDlg" />
      <DialogRef Id="BrowseDlg" />
      <DialogRef Id="InvalidDirDlg" />
      <DialogRef Id="DiskCostDlg" />
      <DialogRef Id="VerifyReadyDlg" />
      <DialogRef Id="MaintenanceWelcomeDlg" />
      <DialogRef Id="MaintenanceTypeDlg" />

      <!-- The folder InstallDirDlg edits. -->
      <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

      <!-- First install / upgrade: Welcome -> Destination Folder -> Ready to install. A patch skips
           the folder (it can't move an installed product). -->
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Condition="NOT Installed" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Condition="Installed AND PATCH" />

      <!-- Destination Folder, as in WixUI_InstallDir: Next sets the folder, validates it (WiX's
           WixUIValidatePath) and refuses one that can't be used; Change... opens the folder browser,
           whose OK validates too. -->
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="SetTargetPath" Value="[WIXUI_INSTALLDIR]" Order="1" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="DoAction" Value="WixUIValidatePath_$(sys.BUILDARCHSHORT)" Order="2"
          Condition="NOT WIXUI_DONTVALIDATEPATH" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="SpawnDialog" Value="InvalidDirDlg" Order="3"
          Condition="NOT WIXUI_DONTVALIDATEPATH AND WIXUI_INSTALLDIR_VALID&lt;&gt;&quot;1&quot;" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="4"
          Condition="WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID=&quot;1&quot;" />
      <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Property="_BrowseProperty" Value="[WIXUI_INSTALLDIR]" Order="1" />
      <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Event="SpawnDialog" Value="BrowseDlg" Order="2" />
      <Publish Dialog="BrowseDlg" Control="OK" Event="DoAction" Value="WixUIValidatePath_$(sys.BUILDARCHSHORT)" Order="3"
          Condition="NOT WIXUI_DONTVALIDATEPATH" />
      <Publish Dialog="BrowseDlg" Control="OK" Event="SpawnDialog" Value="InvalidDirDlg" Order="4"
          Condition="NOT WIXUI_DONTVALIDATEPATH AND WIXUI_INSTALLDIR_VALID&lt;&gt;&quot;1&quot;" />

      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="InstallDirDlg" Order="1"
          Condition="NOT Installed" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="3"
          Condition="Installed AND PATCH" />

      <!-- Maintenance: Welcome -> Repair / Remove -> Ready. -->
      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2"
          Condition="Installed AND NOT PATCH" />

      <!-- Completion page: optionally launch, then close. -->
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApp" Order="1"
          Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />

      <!-- One feature, nothing to change: no "Change" in Apps & features. -->
      <Property Id="ARPNOMODIFY" Value="1" />
    </UI>

    <UIRef Id="WixUI_Common" />
  </Fragment>

  <Fragment>
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Component Id="DacApp" Guid="8A1D3A39-F7C1-47B1-97AE-40C80BF82F4A">
        <File Id="AppExe" Source="$(var.BinDir)\{{binary}}.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="{{display_name}}"
              Description="{{display_name}}: {{tagline}}" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="AppIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\{{binary}}.exe" Value="[#AppExe]" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\{{display_name}}" Name="InstallFolder" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

      <Component Id="AppCli">
        <File Id="AppCliExe" Source="$(var.BinDir)\{{cli_binary}}.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
